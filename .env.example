# Modèle d'environnement local (copier en `.env.local`, ignoré par git).
#
# ⚠️ Aucune variable n'est consommée par l'application pour l'instant :
# elle fonctionne uniquement avec des données factices (`src/data/fixtures.ts`).
# Ce fichier est conservé pour le rebranchement futur du BFF.
#
# ⚠️ Tout ce qui est préfixé `EXPO_PUBLIC_` est EMBARQUÉ dans le binaire (APK/IPA) :
# n'y mettre que des identifiants publics, jamais un secret.

EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_OIDC_AUTHORITY=
EXPO_PUBLIC_OIDC_CLIENT_ID=
