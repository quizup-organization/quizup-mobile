# QuizUp mobile — modèle d'environnement local.
#
# Copier en `.env.local` (ignoré par git) et renseigner les valeurs :
#   cp .env.example .env.local
#
# ⚠️ Tout ce qui est préfixé `EXPO_PUBLIC_` est EMBARQUÉ dans le binaire
# (APK/IPA) et donc lisible par n'importe qui. N'y mettre que des identifiants
# publics. Les valeurs de production sont injectées par la CI
# (`mobile-release.yml`), jamais par ce fichier.

# --- BFF / identité -----------------------------------------------------------
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_OIDC_AUTHORITY=
EXPO_PUBLIC_OIDC_CLIENT_ID=
# Override explicite de l'URL identity (facultatif ; ne jamais committer localhost)
EXPO_PUBLIC_IDENTITY_URL=

# --- Google Sign-In (public) --------------------------------------------------
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_SIGN_IN_ENABLED=
# iOS uniquement (facultatif)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=

# --- Facebook Sign-In (App ID public, Client Token fourni au build) ------------
EXPO_PUBLIC_FACEBOOK_APP_ID=
EXPO_PUBLIC_FACEBOOK_CLIENT_TOKEN=
EXPO_PUBLIC_FACEBOOK_SIGN_IN_ENABLED=
