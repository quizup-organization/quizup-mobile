# Modèle d'environnement local (copier en `.env.local`, ignoré par git).
#
# ⚠️ Tout ce qui est préfixé `EXPO_PUBLIC_` est EMBARQUÉ dans le binaire (APK/IPA) :
# n'y mettre que des identifiants publics, jamais un secret.

EXPO_PUBLIC_API_URL=https://api.quizup.cnadjim.fr
EXPO_PUBLIC_IDENTITY_URL=https://identity.quizup.cnadjim.fr
EXPO_PUBLIC_OIDC_AUTHORITY=https://identity.quizup.cnadjim.fr
EXPO_PUBLIC_OIDC_CLIENT_ID=mobile

# Google : le client Web sert d'audience côté identity ; le client iOS est requis
# uniquement pour les builds iOS (URL scheme). Le client Android est identifié par
# le package `fr.cnadjim.quizup` + l'empreinte SHA-1 déclarée dans Google Cloud.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=270229696016-9u3916ckfcludqv77uiebgir65j3eurk.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Facebook : App ID public + Client Token public (Settings > Advanced).
EXPO_PUBLIC_FACEBOOK_APP_ID=2122240041993058
EXPO_PUBLIC_FACEBOOK_CLIENT_TOKEN=
