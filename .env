# API via gateway
# - simulateur iOS / web : http://localhost:8080
# - émulateur Android    : http://10.0.2.2:8080
# - appareil physique     : http://<IP_LAN_DE_LA_MACHINE>:8080
EXPO_PUBLIC_API_URL=http://localhost:8080

# Issuer OIDC (quizup-identity) — mêmes règles d'adressage que ci-dessus.
EXPO_PUBLIC_OIDC_AUTHORITY=http://localhost:8085
EXPO_PUBLIC_OIDC_CLIENT_ID=mobile
